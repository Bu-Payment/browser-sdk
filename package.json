{
  "name": "@bu-payment/browser-sdk",
  "version": "0.1.0",
  "description": "Browser-safe BuPayment client for public catalogue and hosted checkout flows.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bu-Payment/browser-sdk.git"
  },
  "homepage": "https://github.com/Bu-Payment/browser-sdk#readme",
  "bugs": {
    "url": "https://github.com/Bu-Payment/browser-sdk/issues"
  },
  "keywords": [
    "bupayment",
    "browser",
    "payments",
    "checkout",
    "typescript"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "bun run build && playwright test",
    "test:coverage": "vitest run --coverage",
    "test:consumer": "bun scripts/installed-consumer.mjs",
    "inspect:bundle": "bun scripts/inspect-bundle.mjs",
    "pack:check": "bun pm pack --dry-run",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:coverage && bun run test:browser && bun run build && bun run inspect:bundle && bun run test:consumer"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@playwright/test": "1.55.1",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14"
}
